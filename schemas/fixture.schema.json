{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wireless-battery.example/schema/fixture.schema.json",
  "title": "Wireless Battery session fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target", "case", "source", "environment", "endpoint", "steps", "expect"],
  "properties": {
    "schema_version": {"const": 1},
    "target": {"type": "object", "additionalProperties": false, "required": ["kind", "id"], "properties": {"kind": {"enum": ["package", "provider", "bluetooth_bas", "xinput"]}, "id": {"type": "string", "minLength": 1}}},
    "case": {"type": "string", "minLength": 1},
    "source": {"enum": ["real", "synthetic"]},
    "environment": {"type": "object", "additionalProperties": false, "required": ["connection"], "properties": {"os": {"type": ["string", "null"]}, "connection": {"type": "string"}, "firmware": {"type": ["string", "null"]}}},
    "endpoint": {"type": "object"},
    "steps": {"type": "array", "items": {"$ref": "#/$defs/step"}},
    "expect": {"type": "object", "required": ["kind"], "properties": {"kind": {"enum": ["reading", "error"]}}}
  },
  "$defs": {
    "step": {
      "type": "object", "additionalProperties": false,
      "required": ["operation", "outcome"],
      "properties": {
        "operation": {"enum": ["send_feature", "get_feature", "write_output", "set_output", "read_input", "get_input", "read_bas", "read_xinput"]},
        "report_id": {"type": ["integer", "null"], "minimum": 0, "maximum": 255},
        "request_hex": {"type": ["string", "null"]},
        "length": {"type": ["integer", "null"], "minimum": 0, "maximum": 4096},
        "outcome": {"type": "object", "required": ["kind"], "properties": {"kind": {"enum": ["ok", "response", "bas", "xinput", "error"]}}}
      }
    }
  }
}
